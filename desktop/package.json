{
  "name": "bot-remote-desktop",
  "productName": "Bot Remote",
  "version": "1.0.0",
  "description": "Bot Remote desktop agent: runs Mineflayer bots locally and connects to the cloud relay.",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "author": "Bot Remote",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.js && node test/agent.e2e.test.js",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir"
  },
  "dependencies": {
    "mineflayer": "^4.33.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.botremote.desktop",
    "productName": "Bot Remote",
    "directories": { "output": "dist" },
    "files": ["electron/**", "agent/**", "bots/**", "services/**", "ui/**", "assets/**", "package.json"],
    "win": { "target": ["nsis"], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
