# Copy to .env for local development. On Render set these in the dashboard / render.yaml.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string (REQUIRED in production - pairing data must survive restarts).
# DATABASE_URL=postgres://user:password@host:5432/botremote
# Set to "true" when connecting to a Postgres that requires TLS (e.g. Render's *external* URL, Neon, Supabase).
DATABASE_SSL=false

# Secret used to HMAC-hash device tokens before storing them. REQUIRED in production, >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing pairing and desktop registration.
TOKEN_PEPPER=

# Optional: if set, desktops must supply this key to register. Recommended for a private server.
REGISTRATION_KEY=

# Number of reverse proxies in front of the app (Render = 1).
TRUST_PROXY=1

# Development only: allow the non-persistent in-memory store when DATABASE_URL is unset.
ALLOW_MEMORY_STORE=true
